# --- Local / SQLite (default, sin Docker) ---
DATABASE_URL=sqlite:///./miifts.db

# --- Docker / Postgres ---
# docker-compose arma DATABASE_URL solo a partir de estas tres variables
# (ver docker-compose.yml) - no hace falta descomentar nada acá.
POSTGRES_USER=ifts
POSTGRES_PASSWORD=ifts
POSTGRES_DB=miifts

SECRET_KEY=cambiar-esto-en-produccion
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Puerto en el que escucha uvicorn dentro del contenedor (Railway lo pisa
# automáticamente con su propia variable PORT).
PORT=8000

# --- Notificaciones Push (VAPID) ---
# Generar claves con: python -c \"from py_vapid import Vapid; v=Vapid(); v.generate_keys(); import base64; from cryptography.hazmat.primitives import serialization; pk=v.private_key.private_numbers().private_value.to_bytes(32,'big'); pub=v.public_key.public_bytes(encoding=serialization.Encoding.X962, format=serialization.PublicFormat.UncompressedPoint); print('VAPID_PUBLIC_KEY:', base64.urlsafe_b64encode(pub).decode().rstrip('=')); print('VAPID_PRIVATE_KEY:', base64.urlsafe_b64encode(pk).decode().rstrip('='))\"
VAPID_PUBLIC_KEY=BA1tqHWxt4mO87lDTHUCILZzivyt7H-5vS0IIUXP7qdVU09M5XWKxxIV6eP_CdD_mDKrHFXFx3HG4Z84r0HXu-U
VAPID_PRIVATE_KEY=cDBR68uAKj0xf6foC1BcvmT1nejS4zRnDZiwLstzqzs
VAPID_CLAIMS_SUB=mailto:admin@miifts.com

# --- Scheduler de recordatorios ---
# Ventana en minutos para buscar recordatorios próximos a vencer (default: 15)
PUSH_REMINDER_WINDOW_MINUTES=15
# Intervalo en minutos para ejecutar el job del scheduler (default: 5)
PUSH_SCHEDULER_INTERVAL_MINUTES=5
